{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DistrictWeatherTelemetryContract",
  "description": "Data contract for Source C (Open-Meteo Hourly Weather Telemetry per Uganda District)",
  "type": "object",
  "required": [
    "district_name",
    "district_pcode",
    "latitude",
    "longitude",
    "timestamp_utc",
    "temperature_c",
    "precipitation_mm",
    "wind_speed_kmh",
    "weather_code",
    "ingested_at"
  ],
  "properties": {
    "district_name": { "type": "string" },
    "district_pcode": { "type": "string" },
    "latitude": { "type": "number", "minimum": -90.0, "maximum": 90.0 },
    "longitude": { "type": "number", "minimum": -180.0, "maximum": 180.0 },
    "timestamp_utc": { "type": "string" },
    "temperature_c": { "type": "number", "minimum": -20.0, "maximum": 60.0 },
    "precipitation_mm": { "type": "number", "minimum": 0.0, "maximum": 500.0 },
    "wind_speed_kmh": { "type": "number", "minimum": 0.0, "maximum": 300.0 },
    "weather_code": { "type": "integer", "minimum": 0 },
    "ingested_at": { "type": "string" }
  },
  "additionalProperties": false
}
